{
  "expo": {
    "name": "VYRA LIVE",
    "slug": "vyralive",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B14",
    "splash": {
      "image": "./icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B14"
    },
    "android": {
      "package": "com.vyralive.app",
      "adaptiveIcon": {
        "foregroundImage": "./icon.png",
        "backgroundColor": "#0B0B14"
      },
      "permissions": ["CAMERA", "RECORD_AUDIO"]
    },
    "plugins": [
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5672817614193994~1234567890",
          "iosAppId": "ca-app-pub-5672817614193994~1234567890"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow VYRA LIVE to access your camera"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "98ac86cc-97fc-4562-a4bf-54259f472552"
      }
    }
  }
}
